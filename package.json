{
  "name": "@weibaohui/dsh-sync",
  "version": "0.4.11",
  "description": "Fork of @weibaohui/dsh-sync 0.4.11 with GitHub PR support (create/merge via api.github.com) and PAT kept out of the synced cordis.patch.yml.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "sync",
    "backup",
    "webdav",
    "git",
    "gitcode",
    "dsh-plugin"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/bundle.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.1.7-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check src/index.js && node --check client/index.js",
    "test": "node --test --experimental-test-isolation=none --test-timeout=120000 --test-force-exit test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build:client && npm run check && npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleXela17/dsh-sync-github.git"
  },
  "homepage": "https://github.com/aleXela17/dsh-sync-github#readme",
  "bugs": {
    "url": "https://github.com/aleXela17/dsh-sync-github/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
